<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
    <body>
      <h1>Thank you for your payment!</h1>
      <p>
        <% if @user.is_a?(User) %>
          Hi <%= @user.first_name %> <%= @user.last_name %>,
        <% else %>
          Hi,
        <% end %>
      </p>
      <p>
        We have received your payment for the IQ Test. Your order number is <%= @order.id %>.
      </p>
      <p>
        You can now view your test results by clicking the link below:
      </p>
      <p>
        <%= link_to 'View Your Results', show_score_url(iqtest_id: @order.iqtest.id, user_type: @user.class.name, user_id: @user.id) %>
      </p>
      <p>
        Thank you for choosing IQ Test Brain!
      </p>
    </body>
</html>
